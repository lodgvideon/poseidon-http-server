# Binaries
bin/
*.exe

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Go
vendor/

# Test / coverage
*.out
*.prof
*.test

# Contention gate working directories. `*.out` above does not cover these — it
# matches a .out suffix, not a -out one — so running the gate the way
# perf-nightly.yml does (CONTENTION_OUT=contention-out) leaves an untracked
# directory of build logs, test binaries and raw benchmark output in the root.
contention-out/
selftest-buildpath-out/
contention-gate-out/

# Logs
.logs/
http-server

# codesearch local index
.codesearch.db/

# Claude Code local settings (per-machine, not shared)
.claude/settings.local.json

# Git worktrees live here. Ignored in-tree rather than only in .git/info/exclude,
# so a fresh clone on another machine gets the same protection: a worktree is a
# full second checkout, and committing one would duplicate the whole repository
# inside itself.
.claude/worktrees/

# CodeGraph local index (per-machine, rebuilt by `codegraph init`)
.codegraph/
